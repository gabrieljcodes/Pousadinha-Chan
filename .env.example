# ============================================
# DISCORD BOT CONFIGURATION
# ============================================
# Obtain your bot token at: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Optional: set a test server ID for instant (0s) slash command updates during development.
# Leave empty for normal global registration.
DEV_GUILD_ID=

# ============================================
# API SERVER CONFIGURATION
# ============================================
ENABLE_API=true
API_PORT=:8080
HOST_API_PORT=8080

# ============================================
# DATABASE CONFIGURATION
# ============================================

# --------------------------------------------
# OPTION 1: Local Docker PostgreSQL (Default for docker compose up)
# --------------------------------------------
# The bot container connects directly to the "postgres" service inside Docker network.
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_password_here
DB_NAME=pousadinha
DB_SSLMODE=disable
HOST_DB_PORT=5432

# --------------------------------------------
# OPTION 2: Remote Supabase / Cloud PostgreSQL
# --------------------------------------------
# If DATABASE_URL is set, it takes precedence over DB_HOST/DB_PORT/etc.
#
# Transaction Pooler mode (recommended for Supabase):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
#
# Direct connection mode:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Gacha: catalog is populated explicitly using /app/gacha (see docs/GACHA.md).
GACHA_ENABLED=false
GACHA_MEDIA_DIR=/app/data/gacha
GACHA_PUBLIC_URL=https://pousadinha.com
GACHA_ROLLS_PER_HOUR=10
GACHA_CLAIM_HOURS=3
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# Optional shared catalog cache. Empty disables Valkey outside Docker.
# Docker Compose defaults to redis://valkey:6379 when this variable is unset.
# VALKEY_URL=redis://127.0.0.1:6379
CATALOG_ADMIN_PASSWORD=
TUNNEL_TOKEN=

# Bot language mode: auto (auto-detect user Discord client language), pt-BR, or en.
# Guild setting set by an admin (/language set) overrides this value for that server.
BOT_LANGUAGE=auto

# Currency settings (customizable bot economy currency, e.g. PouCoin / PC)
CURRENCY_NAME=PouCoin
CURRENCY_SYMBOL=PC

# Media backend. Existing local files remain readable in s3 mode.
GACHA_STORAGE_BACKEND=filesystem
GACHA_S3_BUCKET=
GACHA_S3_REGION=
GACHA_S3_ENDPOINT=
GACHA_S3_PREFIX=
GACHA_S3_PATH_STYLE=false
# OpenDAL S3 credentials. Use these values or configure a native provider profile/role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_EC2_METADATA_DISABLED=false
