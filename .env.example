# ============================================
# DISCORD BOT CONFIGURATION
# ============================================
DISCORD_TOKEN=your_discord_token_here

# ============================================
# DATABASE CONFIGURATION
# ============================================

# --------------------------------------------
# POSTGRESQL CONFIGURATION
# --------------------------------------------
# Using pgx driver (github.com/jackc/pgx/v5) - recommended by Supabase
#
# Option 1: Connection Pooler (recommended for serverless/edge functions)
# Found at: Supabase Dashboard > Settings > Database > Connection string > Transaction mode (pooler)
# Note: pgx driver works correctly with Supabase pooler
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Option 2: Direct connection (Session mode)
# Found at: Supabase Dashboard > Settings > Database > Connection string > Session mode (direct)
# DIRECT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option 3: Individual configuration (alternative if not using full URL)
# DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_NAME=postgres
# DB_SSLMODE=require



